flowchart TD
    %% Styling
    classDef store fill:#673ab7,stroke:#333,stroke-width:2px,color:#fff
    classDef api fill:#009688,stroke:#333,stroke-width:2px,color:#fff
    classDef logic fill:#ff9800,stroke:#333,stroke-width:2px,color:#fff
    classDef repodb fill:#f44336,stroke:#333,stroke-width:2px,color:#fff
    classDef repofs fill:#e91e63,stroke:#333,stroke-width:2px,color:#fff
    classDef query fill:#4caf50,stroke:#333,stroke-width:2px,color:#fff

    %% -----------------------------------------
    %% 1. In-Memory State
    %% -----------------------------------------
    subgraph State [AppStateStore - In-Memory]
        Store["getState() / setState()
        ---
        Server State Variables:
        • workspace_layout: object
        • tool_config: object
        • zoom: number
        • tool: string
        • libraryPath: string | null
        • leftPct: number
        • scrollTop: number
        • selectedMarkId: string | null
        • marks: Map<string, MarkDTO>"]:::store
    end

    %% -----------------------------------------
    %% 2. Read Pathway (QueryAPI)
    %% -----------------------------------------
    subgraph QAPI [QueryAPI - Read Operations]
        Q1[getCurrentSession]:::query
        Q2[getMark]:::query
        Q3[getAllMarks]:::query
        Q4[getWhiteboardSnapshot]:::query
        Q5[getSettings]:::query
        Q6[getRecents]:::query
        Q7[getLibraryPath]:::query
        Q8[getBackupPath]:::query
    end

    Q1 -->|Reads| Store
    Q2 -->|Reads| Store
    Q3 -->|Reads| Store
    Q5 -->|Reads DB| R_State
    Q6 -->|Reads DB| R_State
    Q7 -->|Reads DB| R_State
    Q8 -->|Reads DB| R_State

    %% -----------------------------------------
    %% 3. Write Pathway (InputAPI)
    %% -----------------------------------------
    subgraph IAPI [InputAPI - Write Operations]
        I1[loadSession]:::api
        I2[updateSplitter]:::api
        I3[selectMark]:::api
        I4[updateScrollTop]:::api
        I5[addMark]:::api
        I6[updateMark]:::api
        I7[deleteMark]:::api
        I8[saveWhiteboardSnapshot]:::api
        I9[saveSettings]:::api
        I10[saveRecents]:::api
        I11[saveLibraryPath]:::api
        I12[saveBackupPath]:::api
        I13[updateZoom]:::api
        I14[updateTool]:::api
    end

    %% -----------------------------------------
    %% 4. Business Logic Services
    %% -----------------------------------------
    subgraph Services [Business Logic Services]
        subgraph SyncSvc [state_sync_service.ts]
            S_load[loadSession]:::logic
            S_sub[Store Subscriber]:::logic
            S_debounce((debouncedPersist 600ms Timer)):::logic
        end

        subgraph MarkSvc [mark_service.ts]
            M_add[addMark]:::logic
            M_update[updateMark]:::logic
            M_delete[deleteMark]:::logic
        end

        subgraph TLDrawSvc [tldraw_service.ts]
            T_saveWB[saveWhiteboardSnapshot]:::logic
        end
    end

    %% -----------------------------------------
    %% 5. Repositories (Persistence Layer)
    %% -----------------------------------------
    subgraph Repositories [Storage Repositories]
        R_Content[(ContentRepository Table: CONTENTS ensureContentExists)]:::repodb
        R_State[(StateInitialValuesRepository Tables: DEFAULT/SPECIFIC_INITIAL_VALUES setSpecificValue)]:::repodb
        R_Mark[(MarkRepository Table: MARKS upsertMarks)]:::repodb
        
        R_Whiteboard[(WhiteboardRepository FileSystem: .tldr files save/load/deleteWhiteboard)]:::repofs
    end

    %% =========================================
    %% BINDINGS: InputAPI
    %% =========================================
    I1 --> S_load
    
    %% Input API Mutates Store Directly!
    I2 -->|Mutates leftPct| Store
    I3 -->|Mutates selectedMarkId| Store
    I4 -->|Mutates scrollTop| Store
    I13 -->|Mutates zoom| Store
    I14 -->|Mutates tool| Store

    I5 --> M_add
    I6 --> M_update
    I7 --> M_delete
    I8 --> T_saveWB

    %% Input API Writes Configurations Directly!
    I9 -->|Writes DB| R_State
    I10 -->|Writes DB| R_State
    I11 -->|Writes DB| R_State
    I12 -->|Writes DB| R_State

    %% =========================================
    %% BINDINGS: State Syncing (The Core Pattern)
    %% =========================================
    S_load -->|Initializes| Store
    
    Store -->|On Mutation| S_sub
    S_sub -->|1. Emits Event| OutputAPI
    S_sub -->|2. Enqueues the Delta| S_debounce
    
    S_debounce -.->|Executes after 600ms| ExecuteAll

    %% =========================================
    %% BINDINGS: Direct Data Writes (Bypassing Sync)
    %% =========================================
    M_add -->|Immediate SQL Write| R_Mark
    M_update -->|Immediate SQL Write| R_Mark
    M_delete -->|Immediate SQL Write| R_Mark

    M_add -->|Updates Cache| Store
    M_update -->|Updates Cache| Store
    M_delete -->|Updates Cache| Store

    %% =========================================
    %% BINDINGS: Database Writes
    %% =========================================
    ExecuteAll[[Execute Save Transaction]]:::logic
    
    ExecuteAll -->|setSpecificValue| R_State

    %% =========================================
    %% BINDINGS: Whiteboard interactions
    %% =========================================
    T_saveWB -->|Saves snapshot directly| R_Whiteboard
    M_delete -->|Deletes snapshot file| R_Whiteboard
    
    Q4 -->|Loads snapshot directly| R_Whiteboard

graph TB
direction TB

    subgraph STORE["Platform & Storage"]
            I1["Data Repositories"]
            I2["Storage Adapter"]
            I3["Platform Utilities Adapter"]
            I9["State Repository"]
            I8["4-layer System"]
            subgraph FILES["Files Library"]
                I4["Data File System"]
                I6["JODO Plugin Files"]
            end
            subgraph SQL["SQL Database"]
                I5["Data SQL Tables"]
                I10["StateInitialValues SQL Tables"]
                I7["Roopa, Kram SQL"]
            end
        end

    subgraph ATMA["Atma"]
        direction TB
        subgraph UI["UI Layer"]
            
            N1["UI State (volatile only)"]
            N2["UI Controller"]
            N3["UI React Components"]
            N5["Component Pool"]
            N4['Signal???']

            subgraph Function_UI["Functionality Layer"]
                D8["Renderer Registries"]
            end
        end
        subgraph BACK["Client Backend"]
            subgraph "Orchestration"
                SERV["Data Services (Mark, tldraw)"]
                SYNC["StateSyncService (Background Subscriber)"]
                COMM["Command Processor (undo/redo)"]  
            end
            S3["AppStateStore (Server State Cache)"]
            
            subgraph API["Backend Boundary"]
                APIIN["Input Processor"]
                APIOUT["Output Processor & Event Stream"]
                QUERY["Query Processor"]
            end
            subgraph Function_Backend["Functionality Layer"]
                D2["Factories"]
                D3["Capability Registries"]
                D4["State Machines??"]
            end
        end
        subgraph DOM["Shared Interfaces"]
            D1["Domain Models"]
            DTO["DTOs"]
        end
    end

    subgraph JODO["JODO API"]
        J1["Plugins Loaded"]
    end

    JODO --> D3 & D8

    UI <--> DOM<--> BACK

    I9 --> I8
    I8 --> I10

